{
  "name": "appsalvos",
  "version": "0.1.0",
  "description": "Conector para o Claude e o ChatGPT analisarem listas de salvos do Instagram e criarem conteúdos",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "check": "for f in server.js src/*.js scripts/*.mjs public/app.js; do node --check $f || exit 1; done",
    "tunel": "node scripts/tunel.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaimarketing/appsalvos.git"
  },
  "bugs": {
    "url": "https://github.com/yaimarketing/appsalvos/issues"
  },
  "homepage": "https://github.com/yaimarketing/appsalvos#readme",
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "zod": "^4.6.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  }
}
