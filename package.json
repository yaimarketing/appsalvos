{
  "name": "appsalvos",
  "version": "0.1.0",
  "description": "Analisa uma coleção de salvos do Instagram e gera conteúdos semelhantes com Claude",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "check": "node --check server.js && for f in src/*.js src/providers/*.js scripts/*.mjs public/app.js; do node --check $f || exit 1; done"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaimarketing/appsalvos.git"
  },
  "bugs": {
    "url": "https://github.com/yaimarketing/appsalvos/issues"
  },
  "homepage": "https://github.com/yaimarketing/appsalvos#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@huggingface/transformers": "^4.3.1",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "marked": "^18.1.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  }
}
