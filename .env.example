# Senha de acesso ao site (obrigatória quando o app fica online)
# APP_PASSWORD=uma-senha-forte
# Chave que criptografa os links do conector. Sem ela, um segredo local é criado em .appsecret.
# APP_SECRET=um-texto-longo-e-aleatorio
# Transcrição dos reels (Whisper no servidor). "Xenova/whisper-base" é mais rápido; "Xenova/whisper-small" é mais preciso.
# WHISPER_MODEL=Xenova/whisper-small
# WHISPER_LANGUAGE=portuguese
# Porta do servidor web
PORT=3000
