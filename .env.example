# Senha de acesso ao app (obrigatória quando o app fica online)
# APP_PASSWORD=uma-senha-forte
# Chaves opcionais do servidor (quem não conectar a própria chave usa estas)
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=...
# Modelo do Claude (padrão: claude-haiku-4-5)
# CLAUDE_MODEL=claude-haiku-4-5
# Transcrição local dos reels (Whisper). "Xenova/whisper-base" é mais rápido; "Xenova/whisper-small" é mais preciso.
# WHISPER_MODEL=Xenova/whisper-small
# WHISPER_LANGUAGE=portuguese
# Ollama (IA gratuita local): endereço e tamanho do contexto
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_NUM_CTX=32768
# Porta do servidor web
PORT=3000
