# Opcional: chave da API da Anthropic usada quando a pessoa não conectou a própria conta Claude
# ANTHROPIC_API_KEY=sk-ant-...
# Modelo do Claude (padrão: claude-haiku-4-5)
# CLAUDE_MODEL=claude-haiku-4-5
# Transcrição local dos reels (Whisper). "Xenova/whisper-base" é mais rápido; "Xenova/whisper-small" é mais preciso.
# WHISPER_MODEL=Xenova/whisper-small
# WHISPER_LANGUAGE=portuguese
# Porta do servidor web
PORT=3000
